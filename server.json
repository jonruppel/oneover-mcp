{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.oneover/mcp",
  "title": "OneOver",
  "description": "GPT, Gemini, Grok and Claude chat plus image, video and audio generation behind one remote MCP server and one key.",
  "version": "2.0.1",
  "websiteUrl": "https://oneover.com/developers/mcp",
  "repository": {
    "url": "https://github.com/jonruppel/oneover-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.oneover.com/functions/v1/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer oo_live_<secret> from https://oneover.com/developers/dashboard",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}